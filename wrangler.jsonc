{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaseri",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e23aaab4-489a-42aa-adfb-fa789f7812e0","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8f73b5655c324420a6add2003cdb2721" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
